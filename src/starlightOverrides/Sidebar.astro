---
// starlight-sidebar-topics injects its own Sidebar override to render its topic list,
// but that override is skipped whenever `components.Sidebar` is already configured
// (as it is here), so swapping in the dropdown variant means reimplementing that
// same wrapper ourselves: the topic switcher, then Starlight's default sidebar tree.
import Default from '@astrojs/starlight/components/Sidebar.astro';
import { TopicsDropdown } from 'starlight-sidebar-topics-dropdown';

const { hasSidebar } = Astro.locals.starlightRoute;
const { isPageWithTopic } = Astro.locals.starlightSidebarTopics;
---

{hasSidebar && isPageWithTopic && <TopicsDropdown />}
<Default><slot /></Default>
