{
    "extends": "astro/tsconfigs/strictest",
    "include": [".astro/types.d.ts", "**/*"],
    "exclude": [
        "**/build",
        "**/node_modules",
        "**/dist",
        "**/out",
        "**/public"
    ],
    "compilerOptions": {
        "lib": ["DOM", "ESNext"],
        "paths": {
            "@components/*": ["./src/components/*"],
            "@data/*": ["./src/data/*"]
        },
        "checkJs": true,
        "incremental": true
    }
}
