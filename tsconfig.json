{
    "extends": "astro/tsconfigs/strictest",
    "include": [".astro/types.d.ts", "**/*"],
    "exclude": ["dist"],
    "compilerOptions": {
        "lib": ["DOM", "ESNext"],
        "paths": {
            "@components/*": ["./src/components/*"],
            "@data/*": ["./src/data/*"]
        },
        "checkJs": true,
        "incremental": true
    }
}
